#!/bin/sh
# Conventional Commits & Issue Reference

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")
conventional_regex='^(feat|chore|merge|fix|docs|test|style)(\([a-zA-Z0-9_-]+\))?: .+'

if ! echo "$commit_msg" | grep -Eq "$conventional_regex"; then
  echo "Commit message does not follow Conventional Commits format."
  echo ""
  echo "Valid format examples:"
  echo "  feat: add login page"
  echo "  feat(ui): add login button"
  echo "  fix: correct null handling"
  echo "  docs: update README"
  echo ""
  echo "Your commit message was:"
  echo "  $commit_msg"
  exit 1
fi

exit 0